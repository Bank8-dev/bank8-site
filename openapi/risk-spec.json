        ],
        "summary": "`GET /v1/health`",
        "description": "Carries the binary's build identity (`version`/`build`, BUILDID-1) so\ncaptain's monitor populates `make status`'s VERSION column for every\ninstance — the consuming BINARY's identity, never a shared crate's.\n\nservice health payload.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness (version, build)"
          }
        },
        "security": []
      }
    },
