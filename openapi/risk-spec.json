              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "description": "run a scenario's shocks against a\npoint-in-time snapshot (on-demand full recompute; never touches the\nincremental hot path). Idempotent per (scenario, snapshot ref)."
      }
    },
    "/v1/stress/scenarios": {
      "post": {
        "tags": [
          "handlers"
        ],
        "summary": "`POST /v1/stress/scenarios`",
        "operationId": "create_scenario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScenarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "description": "author a declarative scenario\n(admin-scoped). Idempotent per (env, name): re-authoring a scenario\nupdates its assumptions in place (registry data, not code)."
      }
    }
  },
  "components": {
    "schemas": {
      "CreateScenarioRequest": {
        "type": "object",
        "description": "Request body for authoring a stress scenario — declarative assumption\nset (shock parameters on the measured dimensions); data, never a\nFunc hook (a hook cannot be audited as a filing input — DESIGN.md\n§10 resolved).",
        "required": [
          "name",
          "assumptions"
        ],
        "properties": {
          "assumptions": {},
          "name": {
            "type": "string"
          }
        }
      },
      "ExposureResponse": {
        "type": "object",
        "description": "A measured exposure position.",
        "required": [
          "id",
          "dimension",
          "currency",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LimitResponse": {
        "type": "object",
        "description": "A configured limit with its current breach state.",
        "required": [
          "id",
          "limit_type",
          "threshold",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "limit_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          }
        }
      },
      "ListExposuresQuery": {
        "type": "object",
        "description": "Query for listing exposures by dimension.",
        "properties": {
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "StressRunRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/stress/run` — an on-demand full recompute\nof the measured dimensions with a scenario's shocks applied.",
        "required": [
          "scenario_id"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpsertLimitRequest": {
        "type": "object",
        "description": "Request body for upserting a limit (jurisdiction floors arrive as\nregistry data through this surface; admins tune thresholds).",
        "required": [
          "limit_type",
          "threshold"
        ],
        "properties": {
          "limit_type": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "policy",
      "description": "Shield policy administration (shared surface)"
    },
    {
      "name": "risk",
      "description": "Bank8:Risk — prudential risk measurement: capital, liquidity, credit (ECL), limits, stress"
    }
  ]
}
